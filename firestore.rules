rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && (
          request.auth.token.email in [
            'khwahish4@icloud.com', 'khwahishwork@gmail.com',
            'Khwahish4@icloud.com', 'Khwahishwork@gmail.com',
            'KHWAHISH4@ICLOUD.COM', 'KHWAHISHWORK@GMAIL.COM'
          ] ||
          request.auth.token.email.lower() in ['khwahish4@icloud.com', 'khwahishwork@gmail.com']
        ))
      );
    }

    // 3. Entity Validation Helpers
    function isValidContactMessage(data) {
      return data.keys().hasAll(['name', 'email', 'message', 'createdAt', 'status'])
        && data.keys().hasOnly(['name', 'email', 'message', 'createdAt', 'status'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.email is string && data.email.matches('^[^@]+@[^@]+\\.[^@]+$')
        && data.message is string && data.message.size() > 0 && data.message.size() <= 2000
        && data.createdAt == request.time
        && data.status in ['unread', 'read', 'archived'];
    }

    function isValidProject(data) {
      return data.keys().hasAll(['title', 'slug', 'thumbnail', 'createdAt', 'isPublished'])
        && data.title is string && data.title.size() > 0
        && data.slug is string && data.slug.size() > 0
        && data.thumbnail is string
        && data.isPublished is bool;
    }

    function isValidTestimonial(data) {
      return data.keys().hasAll(['name', 'role', 'organisation', 'content', 'createdAt'])
        && data.name is string && data.name.size() > 0
        && data.role is string && data.role.size() > 0
        && data.organisation is string && data.organisation.size() > 0
        && data.content is string && data.content.size() > 0;
    }

    // 4. Collections
    match /messages/{messageId} {
      allow create: if isValidContactMessage(incoming());
      allow get, list, delete: if isAdmin();
      allow update: if isAdmin() && isValidContactMessage(incoming());
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (
        request.auth.uid == adminId ||
        isAdmin()
      ); 
    }

    match /projects/{projectId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidProject(incoming());
      allow delete: if isAdmin();

      match /contentChunks/{chunkId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidTestimonial(incoming());
      allow delete: if isAdmin();
    }
  }
}
